<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:elevation="4dp">

    <TextView
        android:id="@+id/title"
        style="?attr/textAppearanceHeadlineSmall"
        android:text="@string/manage_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/newLabelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_label"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_edittext_rounded"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="18sp" />

    <Button
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add"
        android:textSize="18sp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_labels"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"
        android:background="@drawable/bg_edittext_rounded"
        android:padding="12dp" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/dangerColor"
        android:visibility="gone"
        android:textSize="14sp" />

    <!-- Add a divider for better separation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/dividerColor" />

    <!-- Labels list placeholder -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/labelList"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>
