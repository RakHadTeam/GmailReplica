<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/title"
        style="?attr/textAppearanceHeadlineSmall"
        android:text="@string/manage_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/newLabelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_label"
        android:textSize="18sp"/>

    <Button
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add"
        android:textSize="18sp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_labels"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md_theme_error"
        android:visibility="gone"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- FIXED HEIGHT LIST: it will scroll internally when too long -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/labelList"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="16dp"
        android:scrollbars="vertical"/>
</LinearLayout>
