<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageProfile"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Profile Picture"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account_circle" />

        <Button
            android:id="@+id/btnChangePicture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primaryColor"
            android:elevation="2dp"
            android:text="Change Profile Picture"
            android:textColor="?android:textColorPrimary" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_edittext_rounded"
            android:hint="Your Name"
            android:textColorHint="?android:textColorSecondary"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSaveUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primaryColor"
            android:elevation="2dp"
            android:textColorHint="?android:textColorSecondary"
            android:text="Save Changes"
            android:textColor="?android:textColorPrimary" />

        <TextView
            android:id="@+id/textSaveError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:textColor="@color/dangerColor"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Blacklist URLs"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editBlacklistAddUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_edittext_rounded"
            android:hint="Add URL to blacklist"
            android:textColorHint="?android:textColorSecondary"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAddUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primaryColor"
            android:elevation="2dp"
            android:text="Add URL"
            android:textColor="?android:textColorPrimary" />

        <EditText
            android:id="@+id/editBlacklistRemoveUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_edittext_rounded"
            android:hint="Remove URL from blacklist"
            android:textColorHint="?android:textColorSecondary"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRemoveUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primaryColor"
            android:elevation="2dp"
            android:text="Remove URL"
            android:textColor="?android:textColorPrimary" />

        <Switch
            android:id="@+id/switchDarkMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark Mode"
            android:layout_marginBottom="16dp" />


    </LinearLayout>
</ScrollView>
