<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rakmail.androidapp">

    <!-- Internet permission for Retrofit/API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidApp">

        <!-- Launcher / entry point -->
        <activity
            android:name=".features.launcher.ui.LauncherActivity"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Inbox list screen -->
        <activity
            android:name=".features.inbox.ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.AndroidApp" />

        <!-- Mail detail screen -->
        <activity
            android:name=".features.maildetail.ui.MailDetailActivity"
            android:exported="false"
            android:parentActivityName=".features.inbox.ui.MainActivity"
            android:theme="@style/Theme.AndroidApp" >
        </activity>

        <!-- User signup & signin -->
        <activity
            android:name=".features.user.ui.signup.SignupActivity"
            android:theme="@style/Theme.AndroidApp.NoActionBar"
            android:exported="false" />
        <activity
            android:name=".features.user.ui.signin.SigninActivity"
            android:theme="@style/Theme.AndroidApp.NoActionBar"
            android:exported="false" />

        <activity android:name=".features.compose.ui.ComposeMailActivity"
            android:parentActivityName=".features.inbox.ui.MainActivity"
            android:theme="@style/Theme.AndroidApp.NoActionBar" />

        <!-- Search screen -->
        <activity
            android:name=".features.search.ui.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.AndroidApp.NoActionBar" />

    </application>
</manifest>
